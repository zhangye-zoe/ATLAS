# =========================
# ATLAS .gitignore
# =========================

# ==========================================
# Data: keep directory structure only
# ==========================================

# 1. Raw training datasets
/data/raw/**
!/data/raw/**/
!/data/raw/**/.gitkeep

# 2. Intermediate preprocessing outputs
/data/interim/**
!/data/interim/**/
!/data/interim/**/.gitkeep

# 3. Processed training datasets
/data/processed/**
!/data/processed/**/
!/data/processed/**/.gitkeep

# 4. External annotation data
/data/external/annotations/**
!/data/external/annotations/**/
!/data/external/annotations/**/.gitkeep

# 5. Preprocessing logs
/preprocessing/logs/**
!/preprocessing/logs/**/
!/preprocessing/logs/**/.gitkeep

# 6. Python temporary files
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/

# 7. System files
.DS_Store


# -------------------------
# Preprocessing logs
# -------------------------
/preprocessing/logs/*
!/preprocessing/logs/.gitkeep

# -------------------------
# Python cache / build files
# -------------------------
__pycache__/
*.py[cod]
*.so
*.egg-info/
build/
dist/

# -------------------------
# Jupyter
# -------------------------
.ipynb_checkpoints/

# -------------------------
# Virtual environments
# -------------------------
.venv/
venv/
env/
.env

# -------------------------
# IDE / OS files
# -------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db

# -------------------------
# Temporary / backup files
# -------------------------
*.tmp
*.temp
*.bak
*.swp
*~

# -------------------------
# Archives and downloaded large files
# -------------------------
*.zip
*.tar
*.tar.gz
*.tgz

# -------------------------
# Common large scientific data files
# -------------------------
*.h5
*.hdf5
*.h5ad
*.h5ad.gz
*.loom
*.mtx
*.mtx.gz
*.tsv.gz
*.bed.gz
*.frag.gz
*.fragments.tsv.gz

# -------------------------
# Model checkpoints / generated binary outputs
# -------------------------
*.pt
*.pth
*.ckpt
*.pkl
*.pickle
*.npy
*.npz

results/